local fs = require("@std/fs")
local path = require("@std/path")
local process = require("@std/process")

local function findRepoRoot(): string
	local dir = path.format(process.cwd())
	for _ = 1, 12 do
		if fs.exists(path.join(dir, "rokit.toml")) and fs.exists(path.join(dir, "workspace/flipbook-core")) then
			return dir
		end
		local parent = path.dirname(dir)
		if parent == dir then
			break
		end
		dir = parent
	end
	error("could not locate the Flipbook repo root")
end

local repoRoot = findRepoRoot()
local failures = {}

local requiredPaths = {
	"docs/obsidian-vault/README.md",
	"docs/site/docusaurus.config.ts",
	"docs/site/sidebars.ts",
	"docs/site/src/remark/obsidian.mjs",
	"docs/site/src/remark/code-sample.mjs",
	"docs/site/src/sidebar/obsidian.mjs",
	"docs/code-samples/README.md",
	"docs/code-samples/extract.mjs",
	"workspace/code-samples/src",
	".github/pull_request_template.md",
}

for _, relativePath in requiredPaths do
	if not fs.exists(path.join(repoRoot, relativePath)) then
		table.insert(failures, `missing path: {relativePath}`)
	end
end

local function requireText(relativePath: string, expected: string)
	local filePath = path.join(repoRoot, relativePath)
	if not fs.exists(filePath) then
		return
	end
	local contents = fs.readFileToString(filePath)
	if not contents:find(expected, 1, true) then
		table.insert(failures, `{relativePath} is missing: {expected}`)
	end
end

requireText("docs/site/docusaurus.config.ts", 'path: "../obsidian-vault"')
requireText("docs/site/docusaurus.config.ts", "remarkObsidian")
requireText("docs/site/docusaurus.config.ts", "remarkCodeSample")
requireText("docs/site/docusaurus.config.ts", "obsidianSidebarItems")
requireText("docs/site/sidebars.ts", 'type: "autogenerated"')
requireText("docs/code-samples/README.md", "```code-sample")

if #failures > 0 then
	for _, failure in failures do
		print(`ERROR: {failure}`)
	end
	error(`Flipbook docs layout check failed with {#failures} finding(s)`)
end

print("Flipbook docs layout matches the write-docs skill.")
